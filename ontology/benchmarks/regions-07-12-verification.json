    "validation_javascript": "const d=JSON.parse(require('node:fs').readFileSync('ontology/research-regions-07-12.json','utf8'));const checks=[]; const ok=(pass,label)=>checks.push({label,result:pass?'PASS':'FAIL'}); const sources=new Map(d.sources.map(s=>[s.source_id,s])); const directions=d.regions.flatMap(r=>r.directions); ok(d.regions.length===6,'six regions');ok(directions.length===12,'twelve directions');ok(new Set(directions.map(x=>x.stable_id)).size===12,'unique directions');ok(sources.size===d.sources.length,'unique sources');for(const r of d.regions){ok(r.directions.length>=2,r.id+' two directions');for(const n of r.directions){ok(n.source_ids.every(s=>sources.has(s)),n.stable_id+' sources resolve');ok(new Set(n.source_ids.map(s=>sources.get(s)?.source_group)).size>=2,n.stable_id+' independent-group count');ok(n.activity_evidence.some(e=>e.date>='2021-09-10'&&e.date<='2026-09-10'&&n.source_ids.includes(e.source_id)),n.stable_id+' recent activity');ok(n.parent_ids.includes(r.id),n.stable_id+' parent region');}}for(const s of d.sources){ok(s.retrieval_status==='VERIFIED'&&s.reviewer_type==='AI'&&s.human_reviewer===null,s.source_id+' explicit AI review');ok(Boolean(s.locator&&s.support_summary&&s.accessed_date==='2026-09-10'),s.source_id+' evidence locator');ok(s.support_summary.split(/\\s+/).length<100,s.source_id+' summary below 100 words');}console.log(JSON.stringify(checks,null,2)); if(checks.some(c=>c.result==='FAIL'))process.exitCode=1;",
    "note": "Run the exact validation_javascript with Node from website. Source-group independence also requires the recorded semantic review; group-string counts alone do not establish independence."
