      "strength": 0.93,
      "label": "不可约性的判据",
      "explanation": "不可约性的定义通过不变子空间是否只有 0、V 来判断。",
      "evidence": "mit-representations#Definitions 1.11–1.12; section:irreducible-representation-definition",
      "lenses": {
        "linear": 1
      }
    },
    {
      "id": "representation--construction--intertwiner",
      "source": "representation",
      "target": "intertwiner",
      "type": "construction",
      "strength": 0.95,
      "label": "相容地比较表示",
      "explanation": "固定同一 G 和 k，用满足 Tρ(g)=σ(g)T 的线性映射比较两个表示。",
      "evidence": "mit-representations#Definition 1.13; section:intertwiner-definition",
      "lenses": {
        "linear": 1,
        "action": 0.55
      }
    },
    {
      "id": "linear-map--specialization--intertwiner",
      "source": "linear-map",
      "target": "intertwiner",
      "type": "specialization",
      "strength": 0.86,
      "label": "加上等变条件",
      "explanation": "交织映射是再满足群作用相容条件的线性映射；不要求可逆。",
      "evidence": "mit-representations#Definition 1.13; section:intertwiner-definition",
      "lenses": {
        "linear": 1
      }
    },
    {
      "id": "action--construction--permutation-representation",
      "source": "action",
      "target": "permutation-representation",
      "type": "construction",
      "strength": 0.96,
      "label": "把点变为基向量",
      "explanation": "有限 G-集合 X 给出基向量 e_x，再线性延拓 g·e_x=e_{g·x}。",
      "evidence": "mit-characters#§3.8, permutation representations; section:permutation-representation-definition",
      "lenses": {
        "action": 1,
        "linear": 1
      }
    },
    {
      "id": "permutation-representation--example--representation",
      "source": "permutation-representation",
      "target": "representation",
      "type": "example",
      "strength": 0.96,
      "label": "由置换得到表示",
      "explanation": "作用律保证置换基向量的算子满足群同态律，因此是表示的具体来源。",
      "evidence": "mit-characters#§3.8; section:permutation-representation-definition",
      "lenses": {
        "action": 0.8,
        "linear": 1
      }
    },
    {
      "id": "permutation-representation--construction--character",
      "source": "permutation-representation",
      "target": "character",
      "type": "construction",
      "strength": 0.8,
      "label": "数固定的基向量",
      "explanation": "对有限集合上的复置换表示，迹等于该群元素固定的点数。",
      "evidence": "mit-characters#§3.8; section:permutation-representation-example",
      "lenses": {
        "linear": 1,
        "action": 0.7
      }
    },
