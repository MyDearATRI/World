      "source": "invariant-subspace",
      "target": "permutation-representation",
      "type": "example",
      "strength": 0.8,
      "label": "常向量给出子表示",
      "explanation": "S_3 的三维置换表示中，e_1+e_2+e_3 张成一个固定直线。",
      "evidence": "mit-representations#Definition 1.11; section:invariant-subspace-example",
      "lenses": {
        "linear": 1,
        "action": 0.6
      }
    },
